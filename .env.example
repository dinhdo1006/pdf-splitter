# MinIO — copy thành .env và điền key (không commit .env)

# API endpoint (port 9000 — console thường là 9001)
MINIO_ENDPOINT=10.10.6.134:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_BUCKET=hsdv-pdf-splitter
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true

# Prefix trong bucket
MINIO_PREFIX_INBOX=inbox
MINIO_PREFIX_OUTPUT=output
MINIO_PREFIX_ARCHIVE=archive/inbox
MINIO_PREFIX_STATUS=jobs

# Thư mục tạm local khi chạy job (tự xóa sau upload, trừ khi --keep-work)
MINIO_WORK_DIR=./work_minio
